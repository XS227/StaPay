datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  PENDING
  RESERVED
  CAPTURED
  FAILED
  CANCELLED
}

model Tenant {
  id                String    @id @default(uuid())
  slug              String    @unique
  customDomain      String?   @unique
  companyName       String
  merchantEmail     String
  vippsClientId     String?
  vippsClientSecret String?
  vippsSubKey       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  products          Product[]
  orders            Order[]
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String
  price       Int
  imageUrl    String?
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Order {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vippsOrderId String      @unique
  totalAmount  Int
  status       OrderStatus @default(PENDING)
  customerInfo Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId])
  @@index([vippsOrderId])
}
